        "statistic": "p50",
        "definition": "Time from scheduled send to full response, successful requests only",
        "compare_as": "relative",
        "minimum_meaningful": 10,
        "weight": 0.3,
        "failures_count_as": "excluded",
        "from": {"raw": "requests", "measure": "latency_ms"}
      },
      {
        "id": "latency_p95",
        "label": "95th percentile latency",
        "unit": "ms",
        "direction": "lower",
        "kind": "latency",
        "statistic": "p95",
        "definition": "Same measurement, 95th percentile of the merged samples",
        "compare_as": "relative",
        "minimum_meaningful": 10,
        "weight": 0.2,
        "failures_count_as": "excluded",
        "from": {"raw": "requests", "measure": "latency_ms"}
      },
      {
        "id": "match_rate",
        "label": "Match rate",
        "unit": "%",
        "direction": "higher",
        "kind": "quality",
        "statistic": "share",
        "definition": "Share of addresses located within 50 m of our surveyed position",
        "compare_as": "difference",
        "minimum_meaningful": 2,
        "weight": 0.3,
        "failures_count_as": "zero",
        "from": {"raw": "requests", "measure": "match"}
      },
      {
        "id": "cost",
        "label": "Cost per 1,000 requests",
        "unit": "USD",
        "direction": "lower",
        "kind": "cost",
        "statistic": "total",
        "definition": "List price per 1,000 requests at the plan tested, read on the public price page (declared)",
        "compare_as": "relative",
        "minimum_meaningful": 10,
        "weight": 0.2
      }
    ],
    "composite": {"computed": false, "note": "Weights record priorities only"},
    "workload": {
      "description": "1,000 delivery addresses sampled from our own orders, with surveyed coordinates",
      "usage_pattern": "One address per request, 5 requests per second, open model",
      "arrival_model": "open, fixed rate of 5 requests per second"
