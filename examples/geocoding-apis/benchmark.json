          "terms": "terms of service, 2026-06",
          "restriction": "none found",
          "checked_url": "https://example.com/geo_a/terms",
          "checked_on": "2026-11-02"
        },
        "variants": {"tested": [], "selected": null},
        "service": {"region": "eu-west", "plan": "standard", "api_version": "2026-09"},
        "pricing": {"model": "per request", "source": "public price page", "date": "2026-11-02", "variable": 0.5, "volume": "per 1,000 requests"}
