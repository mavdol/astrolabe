      {"candidate": "geo_a", "metric": "latency_p95", "value": 179.2, "n": 1000, "source": "computed", "ci": [172.705, 185.24], "method": "bootstrap, resampling items", "ci_level": 0.95},
      {"candidate": "geo_b", "metric": "latency_p95", "value": 207.42, "n": 1000, "source": "computed", "ci": [194.5, 223.5], "method": "bootstrap, resampling items", "ci_level": 0.95},
      {"candidate": "geo_a", "metric": "match_rate", "value": 95.05, "n": 1000, "source": "computed", "ci": [94.324, 95.776], "se": 0.369979, "method": "t", "ci_level": 0.95},
